# ─────────────────────────────────────────────
#  RAGLens — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# asyncpg driver is required by the API
DATABASE_URL=postgresql+asyncpg://raglens:raglens@localhost:5432/raglens

# Sync URL used by Alembic migrations only
DATABASE_SYNC_URL=postgresql://raglens:raglens@localhost:5432/raglens

# ── API ───────────────────────────────────────
# Change this to a long random string in production
SECRET_KEY=changeme-use-a-real-secret-in-production-min-32-chars

# Comma-separated list of allowed CORS origins (no wildcards in production)
CORS_ORIGINS=http://localhost:3000

# Maximum accepted trace payload in bytes (default 5 MB)
MAX_TRACE_PAYLOAD_BYTES=5242880

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# API host/port (used inside Docker)
API_HOST=0.0.0.0
API_PORT=8000

# ── Web ───────────────────────────────────────
# URL the Next.js frontend uses to call the API (browser-side)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── PostgreSQL (Docker Compose only) ──────────
POSTGRES_USER=raglens
POSTGRES_PASSWORD=raglens
POSTGRES_DB=raglens

# ── Python SDK / demo ─────────────────────────
# SDK reads process environment; export these when running the demo directly.
RAGLENS_API_KEY=
RAGLENS_BASE_URL=http://localhost:8000
RAGLENS_ENABLED=true
RAGLENS_PROJECT_ID=
RAGLENS_WEB_URL=http://localhost:3000

# ── Diagnostic thresholds ─────────────────────
DIAG_LOW_RETRIEVAL_SCORE_THRESHOLD=0.70
DIAG_RETRIEVAL_WASTE_RATIO=3.0
DIAG_SLOW_RETRIEVAL_MS=500
DIAG_EXCESSIVE_CONTEXT_PCT=0.80
DIAG_LOW_CONTEXT_UTILIZATION_PCT=0.40
DIAG_SLOW_GENERATION_PCT=0.85
DIAG_TOKEN_HEAVY_CONTEXT_PCT=0.85
