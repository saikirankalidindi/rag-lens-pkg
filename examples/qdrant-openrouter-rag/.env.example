# ── OpenRouter Configuration (Embeddings & Chat) ───────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=openai/gpt-4o-mini

# ── Qdrant Cloud Configuration ───────────────────────────────────────────────
# Get your cluster URL and API key from https://cloud.qdrant.io
# If left empty, the app automatically falls back to local embedded Qdrant storage.
QDRANT_URL=https://your-cluster-id.eu-central.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=bookmyshow_rag

# ── RAGLens Observability Configuration ──────────────────────────────────────
RAGLENS_API_KEY=rgl_test_bookmyshow_demo_key_123
RAGLENS_PROJECT_ID=project_aaw3236s8tx5qsr1gi0wefnyj7
RAGLENS_BASE_URL=http://localhost:8000
RAGLENS_WEB_URL=http://localhost:3000
RAGLENS_ENABLED=true
